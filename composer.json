{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nuzul-fikrie-salam/laravel-mailmanager",
    "description": "Laravel 13 email manager ,with SMTP and unlayer intergration",
    "keywords": [
        "laravel",
        "nuzul-fikrie-salam",
        "laravel-mailmanager"
    ],
    "homepage": "https://github.com/nuzul-fikrie-salam/laravel-mailmanager",
    "license": "MIT",
    "authors": [
        {
            "name": "NUZUL FIKRIE SALAM",
            "email": "nuzulfikrie@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0||^13.0",
        "owen-it/laravel-auditing": "^14.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "laravel/pao": "^1.0",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "NuzulFikrieCoder\\LaravelMailmanager\\": "src/",
            "NuzulFikrieCoder\\LaravelMailmanager\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NuzulFikrieCoder\\LaravelMailmanager\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "@php -r \"@mkdir('vendor/orchestra/testbench-core/laravel/bootstrap/cache', 0777, true);\"",
            "vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "NuzulFikrieCoder\\LaravelMailmanager\\LaravelMailmanagerServiceProvider"
            ],
            "aliases": {
                "LaravelMailmanager": "NuzulFikrieCoder\\LaravelMailmanager\\Facades\\LaravelMailmanager",
                "EmailTemplate": "NuzulFikrieCoder\\LaravelMailmanager\\Facades\\EmailTemplate",
                "MailmanagerSettings": "NuzulFikrieCoder\\LaravelMailmanager\\Facades\\MailmanagerSettings"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
